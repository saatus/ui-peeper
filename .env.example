# Copy to .env and adjust as needed. Every value here is optional.

PORT=3000

# Point Playwright at a specific Chromium binary. Needed when the installed
# browser build does not match the Playwright version in package.json.
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# Behind nginx or a PaaS router, set this so per-IP rate limiting sees the real
# client instead of the proxy. Accepts anything Express trust-proxy accepts.
# TRUST_PROXY=1

# --- render tuning -----------------------------------------------------------
# UI_PEEPER_NAV_TIMEOUT_MS=30000
# UI_PEEPER_SETTLE_MS=600
# UI_PEEPER_MAX_PAGE_HEIGHT=20000
# UI_PEEPER_CONCURRENCY=3          # raise only with RAM to spare (~350MB each)
# UI_PEEPER_JOB_TTL_MS=900000

# --- rate limiting -----------------------------------------------------------
# UI_PEEPER_RATE_CAPACITY=12
# UI_PEEPER_RATE_REFILL=12

# DANGEROUS. Disables the DNS/private-IP guard, which is the only thing stopping
# this service from screenshotting cloud metadata endpoints and internal
# dashboards on request. Set it ONLY where egress is already restricted at the
# network layer, or when pointing the local test suite at a localhost fixture.
# UI_PEEPER_TRUST_NETWORK=1
